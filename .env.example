# Production must use its exact HTTPS origin, without trailing slash.
APP_ORIGIN=http://localhost:3000
DATA_DIR=.data
# Generate a fresh secret, at least 32 random characters; never commit it.
KLIPFON_SETUP_SECRET=

# Public widget identifiers from Tawk.to > Administration > Chat Widget.
# Read at runtime. Empty values disable chat; unset uses Klipfon's widget.
TAWK_PROPERTY_ID=6aadc798c048683449aa1362
TAWK_WIDGET_ID=default
